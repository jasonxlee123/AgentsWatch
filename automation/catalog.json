{
  "schema_version": 1,
  "operations": [
    {
      "code": "server.bootstrap_ssh",
      "name": "首次纳管服务器",
      "description": "使用已加密保存的服务器密码首次登录，安装平台公钥和 Python 3，并以仅公钥方式复验后完成纳管。",
      "category": "连接与诊断",
      "scope": "server",
      "version": "1.0.0",
      "playbook": "playbooks/server/bootstrap_ssh.yml",
      "risk_level": "medium",
      "requires_become": false,
      "supports_batch": false,
      "timeout_seconds": 300,
      "parameters": {}
    },
    {
      "code": "server.check_connection",
      "name": "检查服务器连接",
      "description": "验证平台到目标服务器的 Ansible 连接与认证是否可用，不修改服务器配置。",
      "category": "连接与诊断",
      "scope": "server",
      "version": "1.0.0",
      "playbook": "playbooks/server/check_connection.yml",
      "risk_level": "low",
      "requires_become": false,
      "supports_batch": true,
      "timeout_seconds": 30,
      "parameters": {}
    },
    {
      "code": "server.collect_facts",
      "name": "采集服务器信息",
      "description": "只读采集主机名、操作系统、CPU、内存、磁盘和网络等基础信息。",
      "category": "资产采集",
      "scope": "server",
      "version": "1.0.0",
      "playbook": "playbooks/server/collect_facts.yml",
      "risk_level": "low",
      "requires_become": false,
      "supports_batch": true,
      "timeout_seconds": 120,
      "parameters": {}
    },
    {
      "code": "server.discover_runtimes",
      "name": "发现运行时",
      "description": "检查已知安装路径和命令，返回服务器上可能存在的 OpenClaw、Hermes 运行时。",
      "category": "资产采集",
      "scope": "server",
      "version": "1.0.0",
      "playbook": "playbooks/server/discover_runtimes.yml",
      "risk_level": "low",
      "requires_become": false,
      "supports_batch": true,
      "timeout_seconds": 120,
      "parameters": {
        "runtime_search_paths": {
          "type": "array",
          "items": "string",
          "required": false,
          "label": "补充搜索路径",
          "description": "每行一个绝对路径；留空时使用 Playbook 内置路径。",
          "placeholder": "/opt/openclaw\n/opt/hermes",
          "min_items": 1,
          "max_items": 20
        }
      }
    },
    {
      "code": "runtime.collect_info",
      "name": "采集运行时信息",
      "description": "只读采集裸金属运行时的实际版本、命令路径、配置与状态路径存在性及端点可用性，并生成发现快照。",
      "category": "资产采集",
      "scope": "runtime",
      "version": "1.0.1",
      "playbook": "playbooks/runtime/collect_info.yml",
      "risk_level": "low",
      "requires_become": false,
      "supports_batch": true,
      "timeout_seconds": 120,
      "parameters": {}
    },
    {
      "code": "runtime.refresh_status",
      "name": "刷新运行时状态",
      "description": "读取裸金属运行时对应 systemd 或 launchd 服务状态，并在已配置端口时探测端点可用性。",
      "category": "状态检查",
      "scope": "runtime",
      "version": "1.2.0",
      "playbook": "playbooks/runtime/refresh_status.yml",
      "sources": ["roles/runtime_control/tasks/main.yml"],
      "risk_level": "low",
      "requires_become": false,
      "supports_batch": true,
      "timeout_seconds": 60,
      "parameters": {}
    },
    {
      "code": "runtime.start",
      "name": "启动运行时",
      "description": "启动裸金属运行时对应的 systemd 或 launchd 服务，并等待已配置端口可连接。",
      "category": "生命周期",
      "scope": "runtime",
      "version": "1.2.0",
      "playbook": "playbooks/runtime/start.yml",
      "sources": ["roles/runtime_control/tasks/main.yml"],
      "risk_level": "medium",
      "requires_become": true,
      "supports_batch": true,
      "timeout_seconds": 120,
      "parameters": {}
    },
    {
      "code": "runtime.stop",
      "name": "停止运行时",
      "description": "停止裸金属运行时对应的 systemd 或 launchd 服务，并等待已配置端口释放。",
      "category": "生命周期",
      "scope": "runtime",
      "version": "1.2.0",
      "playbook": "playbooks/runtime/stop.yml",
      "sources": ["roles/runtime_control/tasks/main.yml"],
      "risk_level": "medium",
      "requires_become": true,
      "supports_batch": true,
      "timeout_seconds": 120,
      "parameters": {}
    },
    {
      "code": "runtime.restart",
      "name": "重启运行时",
      "description": "重启裸金属运行时对应的 systemd 或 launchd 服务，并等待已配置端口重新可连接。",
      "category": "生命周期",
      "scope": "runtime",
      "version": "1.2.0",
      "playbook": "playbooks/runtime/restart.yml",
      "sources": ["roles/runtime_control/tasks/main.yml"],
      "risk_level": "medium",
      "requires_become": true,
      "supports_batch": true,
      "timeout_seconds": 180,
      "parameters": {}
    },
    {
      "code": "agent.apply_deployment",
      "name": "部署或同步智能体",
      "description": "在受管裸金属 OpenClaw 运行时中同步主子智能体、独立飞书账户与路由，校验后重启共享运行时并确认平台部署关系。",
      "category": "部署管理",
      "scope": "agent",
      "version": "1.2.0",
      "playbook": "playbooks/agent/apply_deployment.yml",
      "sources": ["roles/runtime_control/tasks/main.yml"],
      "risk_level": "medium",
      "requires_become": false,
      "supports_batch": false,
      "timeout_seconds": 180,
      "parameters": {
        "runtime_id": {
          "type": "string",
          "required": true,
          "label": "目标运行时 ID",
          "description": "只能选择活动的裸金属 OpenClaw 运行时。",
          "max_length": 36
        },
        "runtime_agent_key": {
          "type": "string",
          "required": true,
          "label": "运行时智能体 ID",
          "description": "OpenClaw 内部稳定 ID，只允许小写字母、数字、下划线和短横线。",
          "max_length": 64
        },
        "workspace_root": {
          "type": "string",
          "required": false,
          "label": "工作区根目录",
          "description": "留空时使用运行时状态目录下的 workspaces。",
          "max_length": 1000
        },
        "model": {
          "type": "string",
          "required": false,
          "label": "模型",
          "description": "留空时沿用 OpenClaw 默认模型。",
          "max_length": 300
        }
      }
    },
    {
      "code": "agent.migrate_deployment",
      "name": "更换智能体运行时",
      "description": "先在目标 OpenClaw 运行时以禁用渠道预部署，再停用源端、激活目标端并原子切换平台关系；失败时恢复源端并清理目标端，身份和工作区始终保留。",
      "category": "部署管理",
      "scope": "agent",
      "version": "1.0.0",
      "playbook": "playbooks/agent/apply_deployment.yml",
      "sources": ["playbooks/agent/remove_deployment.yml", "roles/runtime_control/tasks/main.yml"],
      "risk_level": "high",
      "requires_become": false,
      "supports_batch": false,
      "timeout_seconds": 360,
      "parameters": {
        "runtime_id": {
          "type": "string",
          "required": true,
          "label": "目标运行时 ID",
          "description": "只能选择未被其他主智能体占用的活动裸金属 OpenClaw 运行时。",
          "max_length": 36
        },
        "expected_deployment_id": {
          "type": "string",
          "required": true,
          "label": "当前部署关系 ID",
          "description": "用于阻止基于过期页面迁移已经变化的部署关系。",
          "max_length": 36
        },
        "runtime_agent_key": {
          "type": "string",
          "required": true,
          "label": "运行时智能体 ID",
          "description": "必须与当前部署的 OpenClaw 稳定 ID 一致，迁移不能更改智能体身份。",
          "max_length": 64
        },
        "workspace_root": {
          "type": "string",
          "required": false,
          "label": "目标工作区根目录",
          "description": "留空时使用目标运行时状态目录下的 workspaces。",
          "max_length": 1000
        },
        "model": {
          "type": "string",
          "required": false,
          "label": "模型",
          "description": "留空时沿用 OpenClaw 默认模型。",
          "max_length": 300
        }
      }
    },
    {
      "code": "agent.remove_deployment",
      "name": "解除智能体运行时部署",
      "description": "清理 OpenClaw 中由 AgentsWatch 管理的渠道账户和绑定后结束平台关系；未解析且从未受管的导入关系仅解除平台记录，身份和工作区始终保留。",
      "category": "部署管理",
      "scope": "agent",
      "version": "1.0.0",
      "playbook": "playbooks/agent/remove_deployment.yml",
      "sources": ["roles/runtime_control/tasks/main.yml"],
      "risk_level": "high",
      "requires_become": false,
      "supports_batch": false,
      "timeout_seconds": 240,
      "parameters": {
        "expected_deployment_id": {
          "type": "string",
          "required": true,
          "label": "当前部署关系 ID",
          "description": "用于阻止基于过期页面解除已经变化的部署关系。",
          "max_length": 36
        }
      }
    }
  ]
}
