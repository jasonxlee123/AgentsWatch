MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:latest
PROMETHEUS_IMAGE=prom/prometheus:latest
ALERTMANAGER_IMAGE=prom/alertmanager:latest
THANOS_IMAGE=quay.io/thanos/thanos:v0.38.0
LOKI_IMAGE=grafana/loki:latest
TEMPO_IMAGE=grafana/tempo:2.7.2
GRAFANA_IMAGE=grafana/grafana:latest
NGINX_IMAGE=nginx:stable-alpine
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:latest

# All persistent service data is stored directly on the mounted data disk.
AGENTSWATCH_DATA_ROOT=/data/agentswatch
# UID/GID of the independent observability adapter writer on this host.
# Keep 10001:10001 for the containerized service account; host systemd/local
# deployments must set these to that process user's numeric IDs.
AGENTSWATCH_OBSERVABILITY_CONTROL_UID=10001
AGENTSWATCH_OBSERVABILITY_CONTROL_GID=10001

# Loki's official default is 0.90. Raise this only after reviewing the host's
# absolute free space and adding a capacity alert.
LOKI_WAL_DISK_FULL_THRESHOLD=0.90

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
THANOS_BUCKET=thanos
TEMPO_BUCKET=tempo
LOKI_BUCKET=loki

CLICKHOUSE_DATABASE=otel
CLICKHOUSE_USER=otel
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_TTL=8760h

# Read-only, post-bootstrap SSH access used by `lobsterctl.py token-fetch`.
# Password SSH is reserved for the explicit first/bootstrap task. Daily tools
# require a verified public key and an administrator-pinned known_hosts file.
LOBSTER_SSH_USER=openclaw
LOBSTER_SSH_PORT=22
LOBSTER_SSH_CONNECT_TIMEOUT=10
LOBSTER_SSH_KNOWN_HOSTS=/opt/agentswatch/ssh/known_hosts
# Leave empty to use the current SSH agent; otherwise set the platform private key.
LOBSTER_SSH_IDENTITY_FILE=
LOBSTER_OPENCLAW_CONFIG_PATH=/home/openclaw/.openclaw/openclaw.json
PROMETHEUS_SECRET_GID=65534

PROMETHEUS_RETENTION=15d
THANOS_RETENTION_RAW=90d
THANOS_RETENTION_5M=730d
THANOS_RETENTION_1H=1825d
TEMPO_RETENTION=720h
LOKI_RETENTION=2160h
OTEL_MEMORY_LIMIT_MIB=1024

ADMIN_BIND_ADDRESS=127.0.0.1
GRAFANA_BIND_ADDRESS=127.0.0.1
OTEL_BIND_ADDRESS=0.0.0.0
GRAFANA_PORT=3000
GRAFANA_PUBLIC_HOST=monitor.example.invalid
GRAFANA_PUBLIC_URL=https://monitor.example.invalid/
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
THANOS_QUERY_PORT=10902
OTEL_OTLP_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133
MINIO_CONSOLE_PORT=9001
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9002

# Management API is disabled unless explicitly enabled. The local development
# stack supplies its own loopback-only database URLs and enables these flags.
AGENTSWATCH_ENABLE_MANAGEMENT=false
AGENTSWATCH_ALLOW_LOCAL_CONNECTION=false
# Map credential aliases stored in the database to private-key file paths.
AGENTSWATCH_CREDENTIAL_FILE_MAP={}
# URL-safe base64 encoded 32-byte key used to encrypt saved Runtime WebUI
# credentials. The local stack creates its own ignored development key.
AGENTSWATCH_WEB_CREDENTIAL_KEY=
# Temporary local SSH tunnel lifetime in seconds.
AGENTSWATCH_WEB_ACCESS_TTL_SECONDS=900
# Local management stack only: adopt this host and a running bare-metal
# OpenClaw LaunchAgent into the seeded Server/Runtime records.
AGENTSWATCH_ADOPT_LOCAL_OPENCLAW=true
