# Copy to /etc/agentswatch/postgres.production.env and restrict to mode 0600.
# The image must be the already approved PostgreSQL 16 tag or immutable digest.
AGENTSWATCH_POSTGRES_IMAGE=
AGENTSWATCH_POSTGRES_DATABASE=agentswatch
AGENTSWATCH_POSTGRES_ADMIN_USER=

# Store the existing administrator password in this root-readable file. The
# password is mounted as a file and never placed in the container environment.
AGENTSWATCH_POSTGRES_ADMIN_PASSWORD_FILE=/etc/agentswatch/postgres/admin-password

AGENTSWATCH_POSTGRES_DATA_ROOT=/data/agentswatch/management/postgres
AGENTSWATCH_POSTGRES_TLS_DIR=/etc/agentswatch/postgres/tls
AGENTSWATCH_POSTGRES_HBA_FILE=/etc/agentswatch/postgres/pg_hba.conf

# Confirm this subnet does not overlap an existing host or Docker network.
AGENTSWATCH_DATABASE_NETWORK_SUBNET=172.30.0.0/24
