# Copy this file outside the source tree, restrict it to mode 0600, and fill
# every blank value. Never commit the populated file.
AGENTSWATCH_MANAGEMENT_IMAGE=registry.example.invalid/agentswatch-management:VERSION
AGENTSWATCH_MANAGEMENT_NGINX_IMAGE=nginx:stable-alpine
AGENTSWATCH_NGINX_GID=101

# Pre-created host directory mounted at /data/agentswatch/management inside the
# container. The deployment guide uses /srv/agentswatch/management; keep this
# value and the `install -d` commands in the guide identical.
AGENTSWATCH_MANAGEMENT_DATA_HOST_ROOT=/srv/agentswatch/management

# Standalone management ingress. The combined overlay disables this service and
# uses the shared HTTPS_PORT/NGINX configuration from the operations env.
AGENTSWATCH_MANAGEMENT_BIND_ADDRESS=0.0.0.0
AGENTSWATCH_MANAGEMENT_HTTPS_PORT=8443
AGENTSWATCH_MANAGEMENT_TLS_DIR=

# External PostgreSQL DSNs. Use distinct least-privilege reader/writer roles.
# Both DSNs must use sslmode=verify-full and the in-container CA path
# /run/secrets/agentswatch-database-ca.crt. The host CA file is mounted there.
AGENTSWATCH_DATABASE_CA_HOST_FILE=
AGENTSWATCH_DATABASE_URL=
AGENTSWATCH_WRITE_DATABASE_URL=

# Generate a Fernet key at deployment time; do not reuse a sample value.
AGENTSWATCH_WEB_CREDENTIAL_KEY=
AGENTSWATCH_SSH_CREDENTIAL_KEY=
AGENTSWATCH_WEB_ACCESS_TTL_SECONDS=900

# JSON map from connection credential_ref to a file mounted below
# /data/agentswatch/management/credentials. Empty braces mean no SSH keys yet.
AGENTSWATCH_CREDENTIAL_FILE_MAP={}
AGENTSWATCH_DEFAULT_SSH_CREDENTIAL_REF=agentswatch-managed

# MCP calls the REST API over a management-internal Unix socket; this only
# controls the upstream response timeout and does not contain a credential.
AGENTSWATCH_MCP_REQUEST_TIMEOUT=30

# Optional HTTP contract to an observability adapter. Leave both blank for
# management-only. The combined overlay injects its internal Nginx URL and the
# token from the combined env; never put a database DSN, Gateway token, or
# filesystem path here.
AGENTSWATCH_OBSERVABILITY_CONTROL_URL=
AGENTSWATCH_OBSERVABILITY_CONTROL_TOKEN=
