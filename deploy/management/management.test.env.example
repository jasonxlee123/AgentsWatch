# Local test deployment only. Copy to /etc/agentswatch/management.env, chmod
# 0600 and fill the blank values. Do not commit the populated file.
AGENTSWATCH_DATABASE_URL=
AGENTSWATCH_WRITE_DATABASE_URL=
AGENTSWATCH_WEB_CREDENTIAL_KEY=
AGENTSWATCH_SSH_CREDENTIAL_KEY=
AGENTSWATCH_WEB_ACCESS_TTL_SECONDS=900
AGENTSWATCH_CREDENTIAL_FILE_MAP='{}'
AGENTSWATCH_DEFAULT_SSH_CREDENTIAL_REF=agentswatch-managed
AGENTSWATCH_DEFAULT_SSH_PRIVATE_KEY_FILE=/data/agentswatch/management/credentials/agentswatch-managed

AGENTSWATCH_ENABLE_MANAGEMENT=true
AGENTSWATCH_SESSION_COOKIE_SECURE=true
AGENTSWATCH_SESSION_COOKIE_PATH=/agentswatch/
# Keep local-process execution disabled. The approved .15 test connection uses
# a loopback-only SSH key so Ansible runs in the openclaw account context.
AGENTSWATCH_ALLOW_LOCAL_CONNECTION=false
AGENTSWATCH_MANAGEMENT_DATA_ROOT=/data/agentswatch/management
AGENTSWATCH_AUTOMATION_DATA_ROOT=/data/agentswatch/management/automation
AGENTSWATCH_STATIC_DIR=/data/agentswatch/management/frontend
AGENTSWATCH_OBSERVABILITY_CONTROL_URL=
AGENTSWATCH_OBSERVABILITY_CONTROL_TOKEN=
HOME=/data/agentswatch/management/home

# The standalone MCP process remains a REST client; HTTP is transported over
# the management-internal API Unix socket in direct-test deployments. This
# socket must never be mounted into the observability stack.
AGENTSWATCH_API_BASE_URL=http://agentswatch-api
AGENTSWATCH_API_UDS=/data/agentswatch/management/run/api.sock
AGENTSWATCH_MCP_REQUEST_TIMEOUT=30
AGENTSWATCH_MCP_TLS_VERIFY=false
