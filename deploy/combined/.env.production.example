# Combined deployment only. Load after the operations and management env files.
# Copy outside the source tree, set mode 0600, and fill every blank value.

# Keep both standalone ingress services disabled even if another env file once
# enabled their profile. A non-empty shell COMPOSE_PROFILES still takes priority,
# so the deployment guide also clears it before every combined operation.
COMPOSE_PROFILES=

AGENTSWATCH_OBSERVABILITY_CONTROL_IMAGE=registry.example.invalid/agentswatch-observability-control:VERSION

# Dedicated SELECT-only role for integration.observability_gateway_v2. Use
# sslmode=verify-full and sslrootcert=/run/secrets/agentswatch-database-ca.crt.
AGENTSWATCH_OBSERVABILITY_INTEGRATION_DATABASE_URL=

# Public OTLP/HTTP endpoint written into generated OpenClaw patches.
AGENTSWATCH_OTEL_ENDPOINT=

# Safety guard: an empty or all-blocked inventory must never replace the active
# monitoring revision. Set this to true only during an explicitly approved full
# observability teardown together with the destructive override below, then
# restore both to false immediately.
AGENTSWATCH_OBSERVABILITY_ALLOW_EMPTY_INVENTORY=false

# A snapshot that removes even one previously deployable runtime requires a
# separate explicit approval. Keep false during normal operations.
AGENTSWATCH_OBSERVABILITY_ALLOW_DESTRUCTIVE_INVENTORY=false

# Independent high-entropy Bearer token used on the internal Nginx hop.
AGENTSWATCH_OBSERVABILITY_CONTROL_TOKEN=

# Optional compose.legacy-openclaw-relay.yml compatibility route. Leave the
# path blank when the overlay is not used.
AGENTSWATCH_LEGACY_OPENCLAW_HTPASSWD_FILE=
AGENTSWATCH_LEGACY_OPENCLAW_PORT=16402
