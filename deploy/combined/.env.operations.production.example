# Copy to /etc/agentswatch/operations.production.env, set mode 0600, and fill
# every blank value. Never commit the populated file. Preserve the currently
# deployed data layout, bucket names and retention values during an upgrade.

# Every image must be an approved, already loaded tag or immutable digest. Do
# not use :latest. Record and verify the local image ID before the maintenance
# window; the production lockdown overlay and `--pull never` prevent pulling.
MINIO_IMAGE=
MINIO_MC_IMAGE=
OTEL_COLLECTOR_IMAGE=
PROMETHEUS_IMAGE=
ALERTMANAGER_IMAGE=
THANOS_IMAGE=
LOKI_IMAGE=
TEMPO_IMAGE=
GRAFANA_IMAGE=
NGINX_IMAGE=
CLICKHOUSE_IMAGE=

# Persistent data and fixed service identities.
AGENTSWATCH_DATA_ROOT=/data/agentswatch
AGENTSWATCH_OBSERVABILITY_CONTROL_UID=10001
AGENTSWATCH_OBSERVABILITY_CONTROL_GID=10001

# Production credentials are mandatory. Use site values from the protected
# existing environment or rotate them through an approved procedure. The
# preflight rejects blanks, examples and known development defaults.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# Preserve existing logical storage names during the data-preserving cutover.
CLICKHOUSE_DATABASE=otel
THANOS_BUCKET=thanos
TEMPO_BUCKET=tempo
LOKI_BUCKET=loki

# Preserve retention and resource settings unless a separate capacity review
# explicitly approves a change.
CLICKHOUSE_TTL=8760h
PROMETHEUS_RETENTION=15d
THANOS_RETENTION_RAW=90d
THANOS_RETENTION_5M=730d
THANOS_RETENTION_1H=1825d
TEMPO_RETENTION=720h
LOKI_RETENTION=2160h
LOKI_WAL_DISK_FULL_THRESHOLD=0.90
OTEL_MEMORY_LIMIT_MIB=1024

# Example topology only. Administrative endpoints remain loopback-only; replace
# the public host and URL with values approved for the deployment environment.
ADMIN_BIND_ADDRESS=127.0.0.1
GRAFANA_BIND_ADDRESS=127.0.0.1
OTEL_BIND_ADDRESS=0.0.0.0
GRAFANA_PORT=3000
GRAFANA_PUBLIC_HOST=monitor.example.invalid
GRAFANA_PUBLIC_URL=https://monitor.example.invalid/
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
THANOS_QUERY_PORT=10902
OTEL_OTLP_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133
MINIO_CONSOLE_PORT=9001
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9002
